# Example environment variables for Lifeline MVP
# Use Supabase or Neon for DATABASE_URL on local dev or deployed env
DATABASE_URL=postgresql://user:password@localhost:5432/lifeline

# External affiliate/API keys (set when you have them). Keep secrets server-side only.
AMAZON_API_KEY=
AMAZON_ASSOCIATE_TAG=
FLIPKART_API_KEY=

# Public site base (used for metadata URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
