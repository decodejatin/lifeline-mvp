# Production Environment Variables
# Copy this to Vercel Dashboard → Settings → Environment Variables

# Database (Supabase/Neon)
DATABASE_URL=postgresql://user:password@host:5432/lifeline

# NextAuth
NEXTAUTH_SECRET=your-generated-secret-here
NEXTAUTH_URL=https://lifeline.vercel.app

# Public URLs (shown in client)
NEXT_PUBLIC_SITE_URL=https://lifeline.vercel.app

# Affiliate APIs (optional for MVP)
AMAZON_API_KEY=
AMAZON_ASSOCIATE_TAG=
FLIPKART_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
